{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/edge",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://mcwm-straddle.co.in/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
